aws_region  = "us-east-1"
name_prefix = "vrdex-restream-worker"

# Optional override after publishing workers/restream/Dockerfile to this stack's ECR repository.
# container_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vrdex-restream-worker:benchmark-2026-06-07"

# References only. Do not put secret values in this file or in terraform.tfvars.
secret_arns = {
  VRDEX_RESTREAM_OUTPUT_CREDENTIAL = "arn:aws:secretsmanager:us-east-1:123456789012:secret:vrdex/restream/example-output"
}

convex_url             = "https://scrupulous-corgi-247.convex.cloud"
max_concurrent_workers = 1
max_session_seconds    = 43200
quality_gate           = "1080p60"
synthetic_variant      = "static-transition"
live_control_schedule  = "output-timeline"
live_control_mode      = "overlay-alpha-volume-fade"
x264_preset            = "veryfast"
synthetic_duration_seconds = 12
max_live_delay_ms          = 10000

# False keeps hosted workers disabled until an approved benchmark enables the switch.
kill_switch_enabled_default = false

# Event runtime remains disabled until sender/provider acceptance.
event_worker_command = false
# Bridge requires VRDEX_EVENT_MEDIA_WORKER_TOKEN_SECRET_ARN (reference only).
# Add that ARN to execution_secret_arns; configure backend admission cap separately.
