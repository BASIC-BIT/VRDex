# BASIC BIT hosted example values. Self-hosted operators should replace these
# with their own Vercel team/project and PostHog project values.

vercel_team_id      = "team_GoHh5xUc96fAIAqJoG55A71S"
vercel_project_name = "vr-dex-web"

posthog_project_id   = 447783
posthog_project_name = "VRDex Analytics"
posthog_host         = "https://us.i.posthog.com"

# Set this in local terraform.tfvars from the PostHog project settings.
posthog_public_key = "phc_REPLACE_WITH_VRDEX_ANALYTICS_PROJECT_KEY"

manage_production_environment = true
manage_preview_environment    = true

# Vercel custom environment ID for the shared `staging` environment.
staging_custom_environment_ids = ["env_1iR8Tk53UMEhsbEgONsgGhzl9hX9"]
