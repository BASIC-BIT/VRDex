# BASIC BIT hosted example values. Self-hosted operators should replace these
# with their own Vercel team/project and PostHog project values.

vercel_team_id      = "team_GoHh5xUc96fAIAqJoG55A71S"
vercel_project_name = "vr-dex-web"

posthog_project_id   = 447783
posthog_project_name = "VRDex Analytics"
posthog_host         = "https://us.i.posthog.com"

# Set this in local terraform.tfvars from the PostHog project settings.
posthog_public_key = "phc_REPLACE_WITH_VRDEX_ANALYTICS_PROJECT_KEY"

# Generate 32 independent cryptographically random bytes, encode them as
# base64, and do not reuse an auth token, encryption key, or provider credential.
temporal_input_hash_key = "REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_SECRET"

# Optional. Create an app in the Twitch developer console and set both values
# to enable cached live status on public profile pages.
twitch_client_id     = null
twitch_client_secret = null

# Optional. Clerk instances are per-environment: production takes the live pair,
# preview and staging take the development instance's test pair. Leave null to
# leave whatever is already set in the Vercel dashboard untouched.
clerk_production_publishable_key = null
clerk_production_secret_key      = null
clerk_preview_publishable_key    = null
clerk_preview_secret_key         = null

manage_production_environment = true
manage_preview_environment    = true

# Vercel custom environment ID for the shared `staging` environment.
staging_custom_environment_ids = ["env_1iR8Tk53UMEhsbEgONsgGhzl9hX9"]
