# Optional for shell-only previews. Set to a Convex deployment URL for live backend reads.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_URL=

# Server-only Convex admin token for route handlers that call internal Convex functions.
CONVEX_ADMIN_TOKEN=

# CI-managed PR preview OAuth persistence bridge. Never enable this in staging or production.
VRDEX_ENABLE_PREVIEW_PERSISTENCE_BRIDGE=false
VRDEX_PREVIEW_PERSISTENCE_SECRET=

# Set true in Vercel if previews must fail when NEXT_PUBLIC_CONVEX_URL is missing.
VRDEX_REQUIRE_CONVEX_URL=false

# Optional PostHog analytics. Missing key keeps analytics disabled.
# BASIC BIT hosted deployments use PostHog project 447783, managed through infra/terraform/vercel.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Clerk is the authentication provider. The publishable key is public and encodes
# the Frontend API host; the secret key is server-only. The Convex deployment
# additionally needs CLERK_JWT_ISSUER_DOMAIN, set with `convex env set`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Discord credentials for the purpose-scoped community-verification round-trip in
# convex/discordVerification.ts. Not sign-in credentials — Clerk holds those —
# but still required. Set on the Convex deployment, alongside SITE_URL.
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Server-only Twitch app credentials for cached public profile live status.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# SES sender, retained for non-auth mail. Clerk sends its own verification email.
AWS_SES_REGION=
AWS_SES_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Developer platform credential hashing. Generate independent random values per environment.
VRDEX_API_TOKEN_PEPPER=
VRDEX_OAUTH_CLIENT_SECRET_PEPPER=
VRDEX_OAUTH_REFRESH_TOKEN_PEPPER=

# OAuth issuer. Store the private key as a PEM string, with \n escapes when required by the host.
VRDEX_OAUTH_ISSUER_URL=
VRDEX_PUBLIC_API_BASE_URL=
VRDEX_MCP_RESOURCE_URI=
VRDEX_HOSTED_MCP_ANONYMOUS_READS=true
VRDEX_OAUTH_ACCESS_TOKEN_SIGNING_KEY=
VRDEX_OAUTH_ACCESS_TOKEN_SIGNING_KID=
VRDEX_OAUTH_ACCESS_TOKEN_ADDITIONAL_PUBLIC_JWKS=

# Hosted request limiting. Production-like deployments should use the Redis REST adapter.
VRDEX_DEPLOYMENT_ENV=development
VRDEX_RATE_LIMIT_STORE=memory
VRDEX_RATE_LIMIT_REDIS_REST_URL=
VRDEX_RATE_LIMIT_REDIS_REST_TOKEN=
VRDEX_RATE_LIMIT_REDIS_PREFIX=vrdex:rate-limit
VRDEX_TRUSTED_PROXY_CLIENT_IP_HEADER=

# Profile-media rollout flags. Mirror the relevant flags in Convex.
VRDEX_PROFILE_MEDIA_DIRECT_UPLOAD_ENABLED=false
VRDEX_PROFILE_MEDIA_ACCESSIBILITY_GENERATION_ENABLED=false
VRDEX_PROFILE_MEDIA_ACCESSIBILITY_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Temporal parser. The keyed input hash secret belongs in Vercel; inference settings belong in Convex.
TEMPORAL_INPUT_HASH_KEY=
TEMPORAL_PARSING_ENABLED=true
TEMPORAL_INFERENCE_BASE_URL=
TEMPORAL_INFERENCE_AUTH_TOKEN=
TEMPORAL_DAILY_ACCOUNT_LIMIT=250
TEMPORAL_MONTHLY_ACCOUNT_LIMIT=2000

# Discord community claim adapter. The bot must be in claimed guilds and able to read members and roles.
DISCORD_BOT_TOKEN=
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Consent screen the browser is sent to. Override only to point at a stub; the
# user's browser follows this carrying the state that authorizes the round-trip,
# so it must be https unless it is loopback.
DISCORD_OAUTH_AUTHORIZE_URL=https://discord.com/oauth2/authorize

# VRChat and VRCLinking proof adapters. Both return { verified, evidenceSource,
# evidenceSummary }; they receive different payloads — see
# docs/deployment/ses-auth-email.md. Both URLs must be https, or http only on
# loopback.
VRCHAT_PROOF_ADAPTER_URL=
VRCLINKING_PROOF_ADAPTER_URL=
VRCHAT_PROOF_ADAPTER_BEARER_TOKEN=
# Required whenever VRCLINKING_PROOF_ADAPTER_URL is set: signs the
# per-delegation capability the adapter verifies as its own
# VRDEX_VRCLINKING_CAPABILITY_KEY. Same value on both sides, and a different
# value from the bearer token — that token authenticates the channel, this
# authorizes the individual guild, so leaking one must not confer the other.
VRCLINKING_ADAPTER_CAPABILITY_KEY=

# Playwright-only E2E helpers. Do not enable in production.
VRDEX_ENABLE_E2E_HELPERS=false
VRDEX_ENABLE_E2E_AUTH_HELPERS=false
VRDEX_ALLOW_PRODUCTION_E2E_HELPERS=false
VRDEX_E2E_BROWSER_TOKEN=
VRDEX_E2E_CONVEX_SECRET=
VRDEX_E2E_RUN_ID=
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_RECORD_VIDEO=false
PLAYWRIGHT_SKIP_WEBSERVERS=false
