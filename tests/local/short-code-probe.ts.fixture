import { internalMutation } from './_generated/server';
import { v } from 'convex/values';
import { allocateShortClaimCode } from './_claimProofCodes';
export const allocate = internalMutation({
 args: { target: v.string() },
 handler: async (ctx, args) => {
  if (!args.target.startsWith('usr_local-short-code-')) throw new Error('fixture target required');
  const original = crypto.randomUUID;
  crypto.randomUUID = () => '00000007-0000-4000-8000-000000000000';
  try {
   const now = Date.now();
   const code = await allocateShortClaimCode(ctx.db, 'vrchat_user', args.target, now);
   const userId = await ctx.db.insert('users', { clerkUserId: args.target, email: 'concurrency@example.test' });
   const profileId = await ctx.db.insert('profiles', { profileType: 'person', slug: args.target, displayName: 'Local fixture', sortName: 'local fixture', aliases: [], tags: [], claimState: 'unclaimed', publicationState: 'draft_private', publicSurfacingState: 'opted_out', creationSource: 'concierge', person: {roleTags: []}, updatedAt: now });
   await ctx.db.insert('profileVerificationAttempts', {userId,profileId,method:'vrchat_user_proof',targetType:'vrchat_user',targetExternalId:args.target,proofCode:code,state:'pending',createdAt:now,updatedAt:now,expiresAt:now+86400000});
   return code;
  } finally { crypto.randomUUID = original; }
 }
});
